# Agri Blockchain MVP - Environment Variables
# Copy to .env and fill in values

# Database
DATABASE_URL=sqlite:///./agri_supply_chain.db

# Blockchain / Anvil
ANVIL_RPC_URL=http://127.0.0.1:8545
# ANCHOR_CONTRACT_ADDRESS=0x...  # Set after deploying DataAnchor contract
# DEPLOYER_PRIVATE_KEY=0x...      # Private key for anchoring transactions

# Anomaly Detection Thresholds
ANOMALY_THRESHOLD_LOW=30
ANOMALY_THRESHOLD_MEDIUM=70
ANOMALY_THRESHOLD_HIGH=70

# Isolation Forest params
ISOLATION_FOREST_CONTAMINATION=0.1
ISOLATION_FOREST_N_ESTIMATORS=100
ISOLATION_FOREST_RANDOM_STATE=42

# Batch Anchoring
BATCH_SIZE_FOR_ANCHORING=10

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Security
SECRET_KEY=dev-secret-key-change-in-production